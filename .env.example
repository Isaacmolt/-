# ============================================
# SheetCraft AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================

# --- Etsy API ---
ETSY_API_KEY=your_etsy_api_keystring_here
ETSY_ACCESS_TOKEN=your_etsy_oauth_access_token
ETSY_REFRESH_TOKEN=your_etsy_oauth_refresh_token
ETSY_SHOP_ID=your_etsy_shop_numeric_id

# --- Gumroad API ---
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here
