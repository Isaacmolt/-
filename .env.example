# ============================================
# SheetCraft AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================

# --- Etsy API ---
ETSY_API_KEY=your_etsy_api_keystring_here
ETSY_ACCESS_TOKEN=your_etsy_oauth_access_token
ETSY_REFRESH_TOKEN=your_etsy_oauth_refresh_token
ETSY_SHOP_ID=your_etsy_shop_numeric_id

# --- Gumroad API ---
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here

# --- SiteCraft：在地商家官網代工（sitecraft/README.md）---
# Google Cloud → 啟用「Places API (New)」→ 憑證 → API 金鑰
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 寄信（Gmail：開兩步驟驗證 → 建立 16 碼「應用程式密碼」）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
SENDER_EMAIL=you@gmail.com
SENDER_NAME=SiteCraft 小站工作室
SENDER_PERSON=你的名字
REPLY_TO=you@gmail.com
CONTACT_LINE=@your-line-id
CONTACT_PHONE=09xx-xxx-xxx
# 示範網站的網址前綴（GitHub Pages 或自訂網域）
DEMO_BASE_URL=https://isaacmolt.github.io/-/sites

# 選用：build_site.py --ai-copy 用 Claude 寫每家店的專屬文案
ANTHROPIC_API_KEY=sk-ant-...
