    d.querySelectorAll('.tile.type .vtext').forEach(function(vt){var cs=vt.querySelectorAll('.vc');if(cs.length!==1)return;var tx=cs[0].textContent;if(tx.length<8)return;var cut=[],at=0;for(var it=seg.segment(tx)[Symbol.iterator](),r=it.next();!r.done;r=it.next()){at+=r.value.segment.length;if(at<tx.length)cut.push(at)}if(!cut.length)return;var best=cut.reduce(function(a,c){return Math.abs(c-tx.length/2)<Math.abs(a-tx.length/2)?c:a});vt.innerHTML='';[tx.slice(0,best),tx.slice(best)].forEach(function(p){var sp=d.createElement('span');sp.className='vc';sp.textContent=p;vt.appendChild(sp)});vt.style.setProperty('--vl',Math.max(best,tx.length-best))})}catch(e){}}});
