  function upd(){var m=maxX(),x=strip.scrollLeft;if(barEl)barEl.style.setProperty('--p',m>0?Math.min(x/m,1).toFixed(3):1);if(prevB)prevB.disabled=x<=2;if(nextB)nextB.disabled=x>=m-2;if(d.activeElement===prevB&&prevB.disabled&&!nextB.disabled)nextB.focus();else if(d.activeElement===nextB&&nextB.disabled&&!prevB.disabled)prevB.focus();strip.dataset.at=at()+1}
