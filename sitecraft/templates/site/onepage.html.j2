.svc li:hover .arr,.svc li>a:focus-visible .arr{background:var(--ink);color:var(--bg);border-color:var(--ink)}.svc li:hover .arr svg,.svc li>a:focus-visible .arr svg{transform:rotate(-45deg)}
@media (max-width:880px){body[data-mode="editorial"] .svc li>a,body[data-mode="editorial"] .svc li>div{grid-template-columns:1fr 40px;grid-template-areas:"h a" "p p" "pr pr";row-gap:var(--s2);padding:var(--s5) 0}body[data-mode="editorial"] .svc .ld{display:none}.svc .price{padding-left:0;font-size:var(--t-l)}.svc .arr{height:40px;padding:0 12px}.svc li:hover h3,.svc li:hover p{transform:none}body:not([data-mode="editorial"]) .svc{grid-template-columns:repeat(2,minmax(0,1fr))}body:not([data-mode="editorial"]) .svc .price{font-size:1.6rem}}
@media (max-width:640px){body:not([data-mode="editorial"]) .svc{grid-template-columns:1fr}}
body[data-mode="bold"] .svc{display:block;background:var(--pd);color:#fff;border-radius:var(--r);padding:clamp(8px,3vw,32px) clamp(20px,4vw,48px);border:0}
body[data-mode="bold"] .svc li{border:0;border-bottom:1px dashed rgba(255,255,255,.24);border-radius:0;background:none}
body[data-mode="bold"] .svc li:last-child{border-bottom:0}
body[data-mode="bold"] .svc li>a,body[data-mode="bold"] .svc li>div{grid-template-columns:minmax(0,1fr) auto 44px;grid-template-rows:auto;grid-template-areas:"h pr a" "p pr a";padding:var(--s5) 0;height:auto;align-items:center}
body[data-mode="bold"] .svc h3{color:#fff}
body[data-mode="bold"] .svc p{color:#fff;opacity:.75}
body[data-mode="bold"] .svc .price{font-family:var(--display),var(--body);font-size:clamp(1.8rem,3.4vw,2.8rem);color:var(--a);align-self:center;margin:0;padding-left:var(--s4)}
body[data-mode="bold"] .svc .arr{border-color:rgba(255,255,255,.3);align-self:center}
body[data-mode="bold"] .svc li::before{background:rgba(255,255,255,.07)}
body[data-mode="bold"] .svc li:hover .arr,body[data-mode="bold"] .svc li>a:focus-visible .arr{background:var(--a);color:var(--pd);border-color:var(--a)}
body[data-mode="bold"] .svc li:has(>a:focus-visible){outline-color:var(--a);outline-offset:4px}
@media (max-width:640px){body[data-mode="bold"] .svc li>a,body[data-mode="bold"] .svc li>div{grid-template-columns:1fr 40px;grid-template-areas:"h a" "p p" "pr pr"}body[data-mode="bold"] .svc .price{padding-left:0;font-size:1.8rem}}
/* signature block: a featured item (food) or three steps (services) */
.sig{margin-top:var(--s8)}
.sig-t{font-size:clamp(1.3rem,2vw,1.6rem);margin-bottom:var(--s5);font-family:var(--display),var(--cjk-head);font-weight:var(--head-weight);line-height:1.3}
.steps ol{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s5)}
.steps li{padding-top:var(--s5);border-top:2px solid var(--ink)}
.steps .sn.num{font-family:var(--display),var(--body);font-weight:500;letter-spacing:-.02em}
.steps .sn{display:block;font-family:var(--cjk-head),var(--display);font-weight:var(--head-weight);font-size:clamp(2.4rem,4vw,3.2rem);line-height:1;color:var(--ink2);margin-bottom:var(--s3)}
.steps b{display:block;font-size:var(--t-xl);margin-bottom:var(--s1)}
.steps p{color:var(--mu);font-size:var(--t-m)}
@media (max-width:640px){.steps ol{grid-template-columns:1fr;gap:var(--s4)}.steps li{display:grid;grid-template-columns:56px 1fr;column-gap:var(--s3)}.steps .sn{grid-row:span 2;margin:0}}
.feature{position:relative;overflow:hidden;isolation:isolate;margin-top:var(--s7);padding:clamp(28px,5vw,56px);border-radius:var(--r);background:var(--pd);color:#fff;display:grid;gap:var(--s2);justify-items:start}
.feature .sig-art{position:absolute;right:3%;top:50%;transform:translateY(-50%);width:min(42%,400px);z-index:-1;opacity:.5;color:#fff;stroke:currentColor;fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.feature .sig-l{display:inline-flex;align-items:center;gap:var(--s2);font-size:var(--t-xs);letter-spacing:.18em;color:#fff;font-weight:700}
.feature .sig-l::before{content:"";width:24px;height:2px;border-radius:2px;background:var(--a)}
.feature h3{font-family:var(--display),var(--cjk-head);font-weight:var(--head-weight);font-size:clamp(2rem,4vw,3.2rem);line-height:1.15;max-width:14ch}
.feature p{opacity:.88;max-width:34ch;font-size:var(--t-l)}
.feature .num{font-size:clamp(1.4rem,2.4vw,1.9rem);color:color-mix(in oklab,var(--a),#fff 24%)}
.feature .btn{margin-top:var(--s3)}
.feature .sig-art .tone *{fill:var(--a);fill-opacity:.25;stroke:none}.feature .sig-art .tone .fine{display:none}.feature .sig-art .ln :is(.acc,.acc2){fill:var(--a);fill-opacity:.5;stroke:currentColor}
@media (max-width:640px){.feature .sig-art{width:36%;top:16px;right:14px;bottom:auto;transform:none;opacity:.3}}

/* gallery */
.gallery .head{display:flex;justify-content:space-between;align-items:flex-end;gap:var(--s5);margin-bottom:var(--s6)}
.gallery .head h2{margin-bottom:0}
.gallery .count{color:var(--mu);white-space:nowrap;display:flex;gap:var(--s4);align-items:center}
.gallery .count .bar{width:96px;height:2px;border-radius:2px;background:var(--line);position:relative;overflow:hidden}
.gallery .count .bar i{position:absolute;inset:0;background:var(--ink);transform-origin:left;transform:scaleX(var(--p,0));transition:transform .3s var(--ease)}
.strip:focus-visible{outline:2px solid var(--ink);outline-offset:6px;border-radius:12px}
.tile img{-webkit-user-drag:none;user-select:none}
.gallery .count button{width:44px;height:44px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;transition:background .3s,color .3s}
.gallery .count button:hover{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.gallery .note{color:var(--mu);font-size:var(--t-s);margin-top:var(--s3);max-width:40ch}
.gallery .count button:disabled{opacity:.35;cursor:default;background:none;color:inherit;border-color:var(--line)}
.strip{--gut:calc((100vw - min(1180px,100vw - 48px))/2);display:flex;align-items:stretch;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:var(--gut);padding:4px var(--gut) 24px;margin-left:calc(-1*var(--gut));width:calc(100% + 2*var(--gut));scrollbar-width:none;-webkit-overflow-scrolling:touch;cursor:grab;user-select:none;-webkit-user-select:none}
.strip::-webkit-scrollbar{display:none}
.strip:active{cursor:grabbing}
.strip{--th:clamp(260px,30vw,420px)}
.tile{position:relative;flex:0 0 auto;width:calc(var(--th)*4/3);height:var(--th);border-radius:var(--r);overflow:hidden;scroll-snap-align:start;background:var(--sf);border:1px solid var(--line)}
.tile.tall{width:calc(var(--th)*3/4)}
.tile.type{display:grid;place-items:center;container-type:size;background:linear-gradient(165deg,var(--a-soft),color-mix(in oklab,var(--a-soft) 55%,var(--sf)))}
.seg{word-break:keep-all;overflow-wrap:anywhere;line-break:strict;hanging-punctuation:allow-end}
.tile.type .vtext{writing-mode:vertical-rl;text-orientation:mixed;font-family:var(--cjk-head),var(--display),var(--body);font-weight:var(--head-weight);font-feature-settings:normal;font-size:min(2.2rem,calc((100cqh - 112px)/(var(--vl,6)*1.24)));letter-spacing:.22em;line-height:1.5;color:var(--ink);margin-bottom:44px}
.tile.type .vc{display:block;white-space:nowrap}
.tile .cap{max-width:calc(100% - 36px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tile.type .cap{white-space:normal;word-break:keep-all;line-height:1.35;border-radius:14px}
@media (max-width:640px){.tile.type .cap{font-size:var(--t-xs);letter-spacing:.06em;padding:5px 10px}.tile .cap-en{display:none}}
.tile.type::before{content:"";position:absolute;left:22px;top:22px;bottom:72px;width:1px;background:var(--ink);opacity:.35}
.tile .cap{color:var(--tx);background:color-mix(in srgb,var(--bg) 84%,transparent)}
.tile::after{content:"";position:absolute;inset:0;background:var(--noise) 0 0/160px 160px;opacity:.14;mix-blend-mode:soft-light;pointer-events:none}
.tile svg.art,.tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
@media (prefers-color-scheme:dark){.tile .art rect.g{fill:color-mix(in oklab,var(--sf) 76%,var(--p))}.tile .art rect.g2{fill:color-mix(in oklab,var(--sf) 60%,var(--p))}.tile .art .k{stroke:color-mix(in oklab,var(--a) 55%,#fff)}.tile .art .pk{stroke:var(--a)}.tile .art circle.ac{opacity:.3}}
.tile:hover svg.art,.tile:hover img{transform:scale(1.04)}
.tile .cap{position:absolute;left:var(--s4);bottom:var(--s4);font-size:var(--t-xs);letter-spacing:.12em;text-transform:uppercase;backdrop-filter:blur(8px);padding:6px 12px;border-radius:999px}
@media (max-width:880px){.strip{--th:clamp(300px,36vw,420px)}.tile.type .cap{letter-spacing:.06em;font-size:var(--t-xs);max-width:calc(100% - 28px)}}
@media (max-width:640px){.strip{--gut:18px;--th:clamp(240px,62vw,300px)}.gallery .head{flex-direction:column;align-items:flex-start;gap:16px}}

/* lightbox */
.lb{border:0;padding:0;margin:auto;max-height:calc(100dvh - 48px);background:transparent;width:fit-content;max-width:none;color:var(--tx);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s var(--ease),transform .5s var(--ease),overlay .5s allow-discrete,display .5s allow-discrete}
.lb[open]{opacity:1;transform:none}
@starting-style{.lb[open]{opacity:0;transform:translateY(14px) scale(.98)}}
.lb::backdrop{background:rgba(0,0,0,.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);transition:background .35s}
@starting-style{.lb[open]::backdrop{background:rgba(0,0,0,0)}}
.lb-frame{--ar:1.333;width:min(92vw,1100px,calc(78vh*var(--ar)));background:var(--bg);border-radius:var(--r);overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,.4)}
.lb-body{aspect-ratio:var(--ar);background:var(--sf);position:relative;outline:0;touch-action:pan-y}
.lb-body img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;animation:fade .3s var(--ease) both}
@media (max-width:640px){.lb{width:100vw;max-width:none;height:100dvh;max-height:none;margin:0}.lb-frame{width:100%;height:100%;border-radius:0;display:grid;grid-template-rows:1fr auto}.lb-body{aspect-ratio:auto}}
.lb-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 12px 12px 20px;font-weight:600}
.lb-nav{display:inline-flex;align-items:center;gap:6px}
.lb-nav button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font-size:1.3rem}
.lb-nav button:hover{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.lb-nav #lbNow{font-family:var(--display);min-width:56px;text-align:center;color:var(--mu)}
.tile[role="button"]{cursor:zoom-in}
.tile:focus-visible{outline-offset:-4px}
/* info */
.info{background:var(--sf)}
.info .cols{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(var(--s6),5vw,var(--s8));align-items:stretch}
.hours{border-top:1px solid var(--line)}
.hours li{display:flex;justify-content:space-between;align-items:center;gap:var(--s3);padding:var(--s4) 0;border-bottom:1px solid var(--line);font-size:var(--t-m)}
.hours li.today{font-weight:700;color:var(--tx);box-shadow:inset 3px 0 0 var(--a);padding-left:12px}
.hours li>span:first-child{white-space:nowrap}.hours li>.num{text-align:right}
.hours .tag{white-space:nowrap;font-size:var(--t-xs);margin-left:var(--s2);letter-spacing:.1em;padding:3px 8px;border-radius:999px;background:var(--ink);color:var(--bg);vertical-align:middle;font-weight:600}
.hours .closed{color:var(--mu)}
.hours .num{font-size:var(--t-m)}
.open-now{display:flex;align-items:center;gap:var(--s2);margin-bottom:var(--s5);font-weight:600;color:var(--tx)}
.open-now .status i{background:#16a34a;box-shadow:0 0 0 0 rgba(22,163,74,.5)}
.open-now .status.off i{background:#dc2626}
.contact{display:grid;gap:var(--s3);margin-top:var(--s6)}
.contact a,.contact button{display:flex;align-items:center;gap:var(--s3);min-height:52px;padding:0 var(--s4);border:1px solid var(--line);border-radius:14px;background:var(--bg);font-weight:600;text-align:left;transition:border-color .3s,transform .3s var(--ease)}
.contact a:hover,.contact button:hover{border-color:var(--ink2);transform:translateX(4px)}
.contact .ico{font-size:1.1rem;color:var(--ink2)}
.contact small{margin-left:auto;flex:none;white-space:nowrap;color:var(--mu);font-weight:500;font-size:var(--t-xs);letter-spacing:.06em}
.contact .addr{flex:1;min-width:0;word-break:keep-all;overflow-wrap:anywhere}
.nb{white-space:nowrap}
.map{border-radius:var(--r);overflow:hidden;border:1px solid var(--line);background:var(--bg);position:relative;isolation:isolate}
.map{display:flex;flex-direction:column}
.map.loaded{min-height:420px}
.map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:saturate(.85)}
@media (prefers-color-scheme:dark){.map iframe{filter:invert(.92) hue-rotate(180deg) saturate(.7)}}
.map-ph{display:flex;flex-direction:column;gap:var(--s3);padding:0 var(--s5) var(--s5);color:var(--tx);flex:1}
.map-ph .art{position:relative;flex:1;min-height:clamp(150px,20vw,240px);margin:0 calc(-1*var(--s5)) var(--s2)}
.map-ph .art::after{content:"";position:absolute;inset:auto 0 0;height:45%;background:linear-gradient(transparent,var(--bg))}
.map-ph .mapart{position:absolute;inset:0;width:100%;height:100%}
.mapart .mb rect{fill:color-mix(in srgb,var(--ink) 7%,transparent)}
.mapart .ml path{stroke:color-mix(in srgb,var(--ink) 14%,transparent);stroke-width:3;stroke-linecap:round;fill:none}
.mapart .mr path{stroke:color-mix(in srgb,var(--ink) 11%,transparent);stroke-width:14;stroke-linecap:round;fill:none}
.map-ph .pin{position:absolute;left:50%;top:46%;z-index:1;width:52px;height:52px;transform:translate(-50%,-50%);color:var(--ink);fill:var(--a-soft)}
.map-ph .addr{font-family:var(--cjk-head),var(--body);font-weight:var(--head-weight);font-size:clamp(1.3rem,2vw,1.7rem);line-height:1.3;max-width:20ch;word-break:keep-all;overflow-wrap:anywhere}
.map-ph .row{display:flex;flex-wrap:wrap;gap:var(--s3) var(--s4);align-items:center}
.map-ph .btn{background:var(--ink);color:var(--bg);min-height:48px;padding:0 var(--s5)}
.map-ph .btn:hover{color:var(--tx)}
.map-ph .tlink{border-bottom-color:var(--line);color:var(--ink)}
.map.loaded .map-ph{display:none}
@media (max-width:880px){.info .cols{grid-template-columns:1fr}}

/* closing */
.closing{background:var(--pd);color:#fff;position:relative;overflow:hidden;isolation:isolate;border-top:1px solid var(--line)}
.closing .cl-motif{position:absolute;right:-2vw;bottom:-1.5vw;width:36vw;max-width:520px;opacity:.22;z-index:-1;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
@media (max-width:640px){.closing .cl-motif{position:relative;display:block;right:auto;bottom:auto;width:84px;margin:0 0 6px 18px;opacity:.4;overflow:visible}}
.closing::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(50% 60% at 15% 100%,color-mix(in oklab,var(--p) 70%,transparent),transparent 70%)}
.closing .wrap{display:grid;grid-template-columns:minmax(0,1fr) min(40vw,560px);gap:40px;align-items:end}
@media (max-width:880px){.closing .wrap{grid-template-columns:1fr}}
.closing h2{font-size:clamp(2.2rem,4.4vw,4rem);margin-bottom:var(--s3)}
.closing p{opacity:.85;max-width:40ch}
.closing .big{font-family:var(--display);font-weight:500;font-size:clamp(1.8rem,4vw,3.4rem);letter-spacing:-.03em;line-height:1.2;display:inline-block;margin-top:var(--s5);border-bottom:2px solid var(--a);padding:8px 0 6px;min-height:48px;transition:color .3s}
.closing .big:hover{color:var(--a)}
.closing .reach{display:flex;flex-wrap:wrap;align-items:center;gap:var(--s4) var(--s6);margin-top:var(--s5)}
.closing .reach .big{margin-top:0}
.closing .reach .cta{margin:0}


/* footer */
footer{background:color-mix(in oklab,var(--pd) 85%,#000);color:#fff;padding:var(--s7) 0}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:var(--s4) var(--s6);align-items:center;font-size:var(--t-s)}
footer p{opacity:.72}
footer .links{display:flex;gap:22px;flex-wrap:wrap}
footer .links a{opacity:.9;border-bottom:1px solid transparent;padding:11px 8px;margin:0 -8px;display:inline-block;transition:border-color .3s}
footer .links a:hover{border-color:var(--a)}
footer small{opacity:.8;font-size:var(--t-xs);display:inline-flex;align-items:center;gap:.4em;min-height:44px}
footer small a{text-decoration:underline;display:inline-block;padding:12px 0}

/* mobile call */
.fab{position:fixed;right:16px;bottom:16px;z-index:90;display:none;border-radius:999px;background:var(--pd);color:#fff;box-shadow:0 16px 36px rgba(0,0,0,.28);overflow:hidden;transform:translateY(140%);opacity:0;visibility:hidden;transition:transform .45s var(--ease),opacity .3s,visibility 0s linear .45s}
body.demo .fab{bottom:78px}
@media (prefers-color-scheme:dark){.fab{background:color-mix(in oklab,var(--pd),#fff 14%);box-shadow:0 0 0 1px rgba(255,255,255,.16),0 16px 36px rgba(0,0,0,.5)}}
body.demo.bar-mini .fab{bottom:56px}
.fab.show{transform:none;opacity:1;visibility:visible;transition:transform .45s var(--ease),opacity .3s,visibility 0s}
.fab a{display:inline-flex;align-items:center;justify-content:center;width:54px;min-height:54px;padding:0}.fab .ico{width:22px;height:22px}
.fab a+a{border-left:1px solid rgba(255,255,255,.25)}.fab a[href*="line.me"]{background:#06C755;color:#06200f}
.fab .ico{font-size:1.2rem}
@media (max-width:880px){.fab{display:flex}}

/* reveal */
.js [data-reveal]{opacity:0;transform:translateY(22px);transition:opacity .9s var(--ease),transform .9s var(--ease);transition-delay:calc(var(--i,0)*90ms)}
[data-reveal].in,.js [data-reveal]:focus-within{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .js .about [data-reveal].in .scene .plate{animation:none}.motif .disc{translate:none}
  .js [data-reveal]{opacity:1;transform:none;transition:none}
  .js h1 .w,.js .tagline,.js .hero .cta,.js .hero .eyebrow,.js .hero .eyebrow::before,.js .hero-foot .fact{animation:none;opacity:1;transform:none}
  .motif .d,.status i{animation:none}.motif svg,.hero>.wrap{transition:none;transform:none}
  .js .motif svg :is(path,circle,ellipse,rect),.js .motif svg .idle.idle-float,.js .motif svg .idle.idle-pulse,.js .motif svg .idle.idle-rotate,.js .cl-motif :is(path,circle,ellipse,rect),.js .closing.in .cl-motif :is(path,circle,ellipse,rect),.js .motif svg .disc,.js .motif svg :is(.acc,.acc2),.js .dw [pathLength],.js [data-reveal].in .dw [pathLength],.js [data-reveal].in .dw [pathLength]:not(.acc):not(.acc2){animation:none;stroke-dashoffset:0;transform:none;stroke-dasharray:none}
  .js .strip .tile{opacity:1;transform:none;transition:none}
  .svc li::before,.svc li h3,.svc li p,.svc .arr,.tile svg.art,.tile img,.btn,.btn::before,.nav,.nav ul a::after,.contact a,.contact button,.lb,.lb::backdrop{transition:none}
  html{scroll-behavior:auto}
}
{% if demo %}
/* demo bar */
.demo-bar{position:fixed;left:0;right:0;bottom:0;z-index:95;background:#0f1115;color:#fff;font-size:var(--t-s);padding:12px 52px 12px 18px;display:flex;gap:6px 18px;align-items:center;justify-content:center;flex-wrap:wrap;text-align:center;box-shadow:0 -10px 30px rgba(0,0,0,.25)}
.demo-bar strong{color:var(--a)}
.demo-bar>span{text-wrap:balance}
.demo-bar a{color:#0f1115;background:#fff;padding:7px 16px;border-radius:999px;font-weight:700;white-space:nowrap;min-height:34px;display:inline-flex;align-items:center}
.demo-bar button{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:44px;height:44px;display:grid;place-items:center;opacity:.75}
.demo-bar .short,.demo-bar .mt{display:none}
.demo-bar.mini{padding-block:8px}
.demo-bar.mini a{min-height:28px;padding:3px 12px}
.demo-bar.mini>span:first-child{display:none}.demo-bar.mini .mt{display:inline;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.demo-bar.mini{flex-wrap:nowrap}
@media (max-width:600px){.demo-bar{font-size:.8rem;line-height:1.5;padding:9px 44px 9px 12px;gap:4px 10px;text-align:left;justify-content:flex-start}.demo-bar .long{display:none}.demo-bar .short{display:inline}.demo-bar a{padding:5px 12px;min-height:30px;font-size:.78rem}}
{% endif %}
</style>
</head>
{% macro weave(id, hole=false) %}<div class="weave" aria-hidden="true"><svg><defs><pattern id="wv{{ id }}" width="150" height="150" patternUnits="userSpaceOnUse"><g transform="scale(.5)">{{ t.motif_b }}</g><g transform="translate(75 75) scale(.5)">{{ t.motif_b }}</g></pattern><linearGradient id="wg{{ id }}"><stop offset=".42" stop-color="#fff" stop-opacity="0"/><stop offset=".72" stop-color="#fff"/></linearGradient>{% if hole %}<radialGradient id="wh{{ id }}" cx=".73" cy=".5" r=".3"><stop offset=".35" stop-color="#000"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>{% endif %}<mask id="wm{{ id }}"><rect width="100%" height="100%" fill="url(#wg{{ id }})"/>{% if hole %}<rect width="100%" height="100%" fill="url(#wh{{ id }})"/>{% endif %}</mask></defs><rect width="100%" height="100%" fill="url(#wv{{ id }})" mask="url(#wm{{ id }})"/></svg></div>{% endmacro %}
<body data-mode="{{ b.mode }}"{% if demo %} class="demo"{% endif %}>
<a class="skip" href="#main">跳至主要內容</a>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s7-6.3 7-11.5a7 7 0 1 0-14 0C5 14.7 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.6"/></symbol>
    <symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4V5Z"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 2.8l2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.9l1.2-6.6L2.5 9.7l6.6-.9L12 2.8Z"/></symbol>
    <symbol id="i-ext" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></symbol>
  </defs>
</svg>

<header class="nav" id="nav">
  <div class="wrap">
    <a class="brand" href="#top"><span class="mark" aria-hidden="true"><svg viewBox="0 0 200 200">{{ t.motif }}</svg></span><span class="bn{% if b.name_zh | length > 8 %} long{% endif %}">{% if b.name_lines[0].kind != "en" %}{% for g in b.name_groups[0] %}{{ g | join("") }}{% if not loop.last %}<wbr>{% endif %}{% endfor %}{% else %}{{ b.name_zh }}{% endif %}{% if b.name_zh != b.name %}<span class="bn-en"> {{ b.name[(b.name_zh | length):] | trim }}</span>{% endif %}</span></a>
    <nav aria-label="主選單">
      <ul>
        {% for k in b.order %}<li><a href="#{{ k }}">{{ b.nav_labels[k] }}</a></li>{% endfor %}
      </ul>
    </nav>
    {% if b.phone_href %}<a class="call" href="{{ b.phone_href }}"><svg class="ico"><use href="#i-phone"/></svg>{{ b.phone }}</a>{% endif %}
  </div>
</header>
<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-label="選單" aria-hidden="true">
  <span class="ov-brand">{{ b.name_zh }}</span>
  <svg class="ov-motif" viewBox="0 0 200 200" aria-hidden="true">{{ t.motif_overlay }}</svg>
  {% for k in b.order %}<a href="#{{ k }}" style="--i:{{ loop.index0 }}">{{ b.nav_labels[k] }}</a>{% endfor %}
  <small><span id="ovHours"><span class="nb">{% if b.today_hours %}今日 {{ b.today_hours }}{% endif %}</span></span><i class="sep"></i><span class="nb">{{ b.address_short }}</span></small>
  <div class="acts">
    {% if b.phone_href %}<a class="btn btn-ghost" href="{{ b.phone_href }}"><svg class="ico"><use href="#i-phone"/></svg>電話</a>{% endif %}
    {% if b.line_url %}<a class="btn btn-line" href="{{ b.line_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-chat"/></svg>LINE</a>{% endif %}
    <a class="btn btn-ghost" href="{{ b.maps_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-pin"/></svg>導航</a>
  </div>
</div>
<button class="menu-btn" id="menuBtn" aria-label="開啟選單" aria-expanded="false" aria-controls="overlay"><span></span><span></span></button>

<main id="main">
{% macro sec_about(n) %}
<section class="about{% if not b.about_photo %} has-art{% endif %}" data-tone="{{ 'sf' if n is even else 'bg' }}" id="about">
  <div class="wrap">
    <div class="label" data-reveal><b>{{ "%02d" % n }}</b>關於我們<svg class="lm dw" viewBox="0 0 200 200" aria-hidden="true">{{ t.motif_b_draw }}</svg></div>
    <div class="txt">
      <h2 class="statement" data-reveal style="--i:1">{% if b.statement_name %}<span class="nm">{% for line in b.name_lines %}{% if line.kind == "en" %}<span class="en">{{ line.tokens | join(" ") }}</span>{% else %}{{ line.tokens | join("") }}{% endif %}{% if not loop.last %} {% endif %}{% endfor %}</span><wbr>{% endif %}{% if b.statement_units %}<span class="un">{{ b.statement_pre }}</span><wbr><em class="un">{{ b.statement_em }}</em>{% else %}{{ b.statement_pre }}<em>{{ b.statement_em }}</em>{{ b.statement_post }}{% endif %}</h2>
      {% for para in b.about_paragraphs %}<p data-reveal style="--i:{{ loop.index + 1 }}">{{ para }}</p>{% endfor %}
    </div>
    <ol class="hl" data-reveal style="--i:2">
      {% for h in b.highlights %}<li>{{ h }}</li>{% endfor %}
    </ol>
    <div class="side">
      {% if b.about_photo %}<figure class="ph" data-reveal style="--i:2"><img src="{{ b.about_photo }}" alt="{{ b.name }}" loading="lazy"></figure>{% else %}<figure class="ph art" data-reveal style="--i:2" aria-hidden="true"><svg class="dw fit scene" viewBox="0 0 400 300">{{ t.motif_about }}</svg></figure>{% endif %}
    </div>
  </div>
</section>
{% endmacro %}
{% macro sec_services(n) %}
<section class="services" data-tone="{{ 'sf' if n is even else 'bg' }}" id="services">
  {{ weave("s") }}
  <div class="wrap">
    <div class="label" data-reveal><b>{{ "%02d" % n }}</b>{{ b.nav_services }}<svg class="lm dw" viewBox="0 0 200 200" aria-hidden="true">{{ t.motif_b_draw }}</svg></div>
    <h2 data-reveal style="--i:1">{{ b.services_title }}</h2>
    <p class="lead" data-reveal style="--i:2">{% if b.services_linked %}{{ b.services_lead }}{% else %}有其他需求也歡迎告訴我們。{% endif %}</p>
    {% set feat = b.signature if (b.signature and b.signature.kind == "feature") else none %}
    {% if feat %}{% set fi = feat.item %}
    <div class="sig feature" data-reveal>
      <svg class="sig-art dw fit" viewBox="-10 -10 220 220" aria-hidden="true">{{ t.motif_feature }}</svg>
      <span class="sig-l">{{ feat.label }}</span>
      <h3>{{ fi.title }}</h3>
      <p>{{ fi.desc }}</p>
      {% if fi.price %}<span class="num">{{ fi.price }}</span>{% endif %}
      {% if fi.href %}<a class="btn btn-solid" href="{{ fi.href }}"{% if fi.href.startswith('http') %} target="_blank" rel="noopener"{% endif %}>{{ b.feature_cta }}<svg class="ico"><use href="#i-arrow"/></svg></a>{% endif %}
    </div>
    {% endif %}
    <ul class="svc">
      {% for s in (b.services[1:] if feat else b.services) %}
      <li data-reveal style="--i:{{ loop.index0 }}">
        {% if s.href %}<a href="{{ s.href }}"{% if s.href.startswith('http') %} target="_blank" rel="noopener"{% endif %}>{% else %}<div>{% endif %}
        <h3>{{ s.title }}</h3>
        <span class="ld" aria-hidden="true"></span>
        <p>{{ s.desc }}</p>
        {% if s.price %}<span class="num price">{{ s.price }}</span>{% endif %}
        {% if s.href %}<span class="arr" aria-hidden="true"><span class="arr-t">{% if s.href.startswith("tel:") %}電話詢問{% elif "line.me" in s.href %}LINE 詢問{% else %}詢問{% endif %}</span><svg class="ico"><use href="#i-arrow"/></svg></span></a>{% else %}</div>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% if b.signature and b.signature.kind == "steps" %}
    <div class="sig steps" data-reveal>
      <h3 class="sig-t">{{ b.signature.title }}</h3>
      <ol>{% for st in b.signature.steps %}<li><span class="sn{% if b.mode != "editorial" %} num{% endif %}" aria-hidden="true">{% if b.mode == "editorial" %}{{ "一二三"[loop.index0] }}{% else %}0{{ loop.index }}{% endif %}</span><b>{{ st.title }}</b><p>{{ st.desc }}</p></li>{% endfor %}</ol>
    </div>
    {% endif %}
  </div>
</section>
{% endmacro %}
{% macro sec_gallery(n) %}
<section class="gallery" data-tone="{{ 'sf' if n is even else 'bg' }}" id="gallery">
  <div class="wrap">
    <div class="head">
      <div>
        <div class="label" data-reveal><b>{{ "%02d" % n }}</b>{{ b.gallery_name }}<svg class="lm dw" viewBox="0 0 200 200" aria-hidden="true">{{ t.motif_b_draw }}</svg></div>
        <h2 data-reveal style="--i:1">{{ b.gallery_title }}</h2>
      </div>
      <div class="count" data-reveal style="--i:2">
        <button type="button" id="prevTile" aria-label="上一張"><svg class="ico" style="transform:rotate(180deg)"><use href="#i-arrow"/></svg></button>
        <span class="bar" id="stripBar" aria-hidden="true"><i></i></span>
        <button type="button" id="nextTile" aria-label="下一張"><svg class="ico"><use href="#i-arrow"/></svg></button>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="strip" id="strip" data-reveal style="--i:2" tabindex="0" role="region" aria-label="{{ b.gallery_name }}，可左右捲動">
      {% for g in b.gallery_items %}
      <div class="tile{% if g.tall %} tall{% endif %}{% if g.type %} type{% endif %}" style="--i:{{ loop.index0 }}">
        {% if g.img %}<img src="{{ g.img }}" alt="{{ b.name }} {{ g.label }}" loading="lazy" draggable="false">{% elif g.type %}<span class="vtext" style="--vl:{{ b.vlen }}">{% for c in b.vcols %}<span class="vc">{{ c }}</span>{% endfor %}</span>{% else %}<span class="dw">{{ g.art }}</span>{% endif %}
        {% if g.img %}<span class="cap">{{ g.label }}</span>{% elif g.type %}<span class="cap">{% if b.name_lines[0].kind != "en" %}{% for g2 in b.name_groups[0] %}{{ g2 | join("") }}{% if not loop.last %}<wbr>{% endif %}{% endfor %}{% else %}{{ b.name_zh }}{% endif %}</span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endmacro %}
{% macro sec_info(n) %}
<section class="info" data-tone="{{ 'sf' if n is even else 'bg' }}" id="info">
  <div class="wrap">
    <div class="label" data-reveal><b>{{ "%02d" % n }}</b>營業資訊<svg class="lm dw" viewBox="0 0 200 200" aria-hidden="true">{{ t.motif_b_draw }}</svg></div>
    <div class="cols">
      <div data-reveal style="--i:1">
        <div class="open-now"><span class="status" id="infoStatus"><i></i><span id="infoStatusText">營業時間</span></span></div>
        {% if b.weekday_hours %}
        <ul class="hours" id="hours">
          {% for h in b.weekday_hours %}
          <li data-day="{{ h.day }}"><span>{{ h.label }}</span><span class="num {% if h.closed %}closed{% endif %}">{% for part in h.text.split("、") %}<span class="nb">{{ part }}</span>{% if not loop.last %}、<wbr>{% endif %}{% endfor %}</span></li>
          {% endfor %}
        </ul>
        {% else %}
        <ul class="hours"><li><span>營業時間</span><span class="closed">請來電詢問</span></li></ul>
        {% endif %}
        <div class="contact">
          <button type="button" id="copyAddr" data-addr="{{ b.address_disp }}"><svg class="ico"><use href="#i-copy"/></svg><span>複製地址</span><small>{{ b.address_short }}</small></button><span class="sr" id="copyLive" aria-live="polite"></span>
          {% if b.phone %}<a href="{{ b.phone_href }}"><svg class="ico"><use href="#i-phone"/></svg><span class="num">{{ b.phone }}</span><small>撥打</small></a>{% endif %}
          {% if b.line_url %}<a href="{{ b.line_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-chat"/></svg>LINE 聯絡我們<small>加入好友</small></a>{% endif %}
        </div>
      </div>
      <div class="map" id="map" data-reveal style="--i:2">
        <div class="map-ph">
          <div class="art">{{ b.map_art }}<svg class="pin" aria-hidden="true" viewBox="0 0 24 24" style="stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round"><use href="#i-pin"/></svg></div>
          <p class="addr">{{ b.address_html }}</p>
          <div class="row">
            <button type="button" class="btn" id="loadMap" data-src="{{ b.embed_url }}" data-title="{{ b.name }} 的位置地圖">載入地圖</button>
            <a class="tlink" href="{{ b.maps_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-ext"/></svg>在 Google 地圖開啟</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endmacro %}
<section class="hero" id="top" data-hero="{{ b.hero_layout }}"{% if b.scrim %} data-scrim{% endif %}{% if b.hero_photo %} data-photo{% endif %} aria-label="{{ b.name }}">
  {% if b.hero_photo %}<figure class="hp" aria-hidden="true"><img src="{{ b.hero_photo }}" alt="" fetchpriority="high"></figure>{% endif %}
    <div class="wrap">
    <p class="eyebrow"><span>{{ b.category }}</span><span>{{ b.city }}{{ b.district }}</span></p>
    <h1 aria-label="{{ b.name }}" style="--len:{{ b.name_len }}">{% set ns = namespace(i=0) %}{% for line in b.name_lines %}{% if line.kind == "en" %}<span class="en">{% for w in line.tokens %}<span class="w" style="--i:{{ ns.i }}">{{ w }}</span>{% if not loop.last %} {% endif %}{% set ns.i = ns.i + 1 %}{% endfor %}</span>{% else %}{% for grp in b.name_groups[loop.index0] %}<span class="wd">{% for w in grp %}<span class="w" style="--i:{{ ns.i }}">{{ w }}</span>{% set ns.i = ns.i + 1 %}{% endfor %}</span>{% endfor %}{% endif %}{% endfor %}</h1>
    <p class="tagline">{{ b.tagline }}</p>
    <div class="cta">
      {% if b.line_url %}<a class="btn btn-line" href="{{ b.line_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-chat"/></svg>LINE 聯絡</a>
      {% if b.phone_href %}<a class="btn btn-ghost" href="{{ b.phone_href }}"><svg class="ico"><use href="#i-phone"/></svg>撥打電話</a>{% endif %}
      {% elif b.phone_href %}<a class="btn btn-solid" href="{{ b.phone_href }}"><svg class="ico"><use href="#i-phone"/></svg>撥打電話</a>{% endif %}
      <a class="tlink" href="{{ b.maps_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-pin"/></svg>查看地圖</a>
    </div>
    <p class="hstat" id="heroStat" aria-hidden="true"><i></i><span class="hs-t"></span>{% if b.rating %}<span class="hs-r"><svg class="star" viewBox="0 0 24 24"><use href="#i-star"/></svg>{{ b.rating }}<small>{{ b.review_count }} 則評論</small></span>{% endif %}</p>
    {% if b.hero_photo %}<figure class="hp-m" aria-hidden="true"><img src="{{ b.hero_photo }}" alt="" loading="lazy"></figure>{% endif %}
    {% if b.hero_layout != "band" and not b.hero_photo %}<div class="motif" aria-hidden="true"><svg viewBox="-10 -10 220 220"><g class="d">{{ t.motif_scene }}</g></svg></div>{% endif %}
  </div>
  <div class="hero-foot">
    {% if b.hero_layout == "band" and not b.hero_photo %}<div class="motif" aria-hidden="true"><svg class="m1 scene" viewBox="0 0 400 300" preserveAspectRatio="xMidYMax meet"><g class="d">{{ t.motif_band }}</g></svg><svg class="m2" viewBox="-10 -10 220 220" preserveAspectRatio="xMidYMax meet"><g class="d">{{ t.motif_band2 }}</g></svg></div>{% endif %}
    <div class="wrap">
      <div class="facts" style="--nf:{{ 2 + (1 if b.rating else 0) + (1 if b.phone else 0) }}">
        <div class="fact" style="--i:0"><b>今日營業</b><span class="status" id="heroStatus"><i></i><span id="heroHours"><span class="nb">{{ b.today_hours or "請來電詢問" }}</span></span></span></div>
        {% if b.rating %}<div class="fact" style="--i:1"><b>Google 評分</b><a href="{{ b.maps_url }}" target="_blank" rel="noopener" aria-label="{{ b.rating }} {{ b.review_count }} 則評論，在 Google 地圖查看"><svg class="star" viewBox="0 0 24 24"><use href="#i-star"/></svg><span class="num">{{ b.rating }}</span> <span class="sub">{{ b.review_count }} 則評論</span></a></div>{% endif %}
        <div class="fact" style="--i:2"><b>地址</b><a class="fl" href="{{ b.maps_url }}" target="_blank" rel="noopener"><span>{{ b.address_short }}</span></a></div>
        {% if b.phone %}<div class="fact" style="--i:3"><b>電話</b>{% if b.phone_href %}<a class="fl" href="{{ b.phone_href }}"><span class="num">{{ b.phone }}</span></a>{% else %}<span class="num">{{ b.phone }}</span>{% endif %}</div>{% endif %}
      </div>
    </div>
  </div>
</section>








{% for k in b.order %}{% if k == "about" %}{{ sec_about(loop.index) }}{% elif k == "services" %}{{ sec_services(loop.index) }}{% elif k == "gallery" %}{{ sec_gallery(loop.index) }}{% elif k == "info" %}{{ sec_info(loop.index) }}{% endif %}
{% endfor %}
<dialog class="lb" id="lb" aria-label="放大檢視">
  <div class="lb-frame" id="lbFrame">
    <div class="lb-body" id="lbBody" tabindex="-1"></div>
    <div class="lb-bar"><span class="lb-cap" id="lbCap"></span><span class="lb-nav"><button type="button" id="lbPrev" aria-label="上一張"><svg class="ico" style="transform:rotate(180deg)"><use href="#i-arrow"/></svg></button><span id="lbNow" aria-live="polite"></span><button type="button" id="lbNext" aria-label="下一張"><svg class="ico"><use href="#i-arrow"/></svg></button><button type="button" id="lbClose" aria-label="關閉">×</button></span></div>
  </div>
</dialog>



<section class="closing" aria-labelledby="closingTitle">
  <svg class="cl-motif" viewBox="0 0 200 200" aria-hidden="true">{{ t.motif_closing }}</svg>
  <div class="wrap">
    <div>
      <h2 id="closingTitle" data-reveal{% if b.closing_closed %} data-closed="{{ b.closing_closed }}"{% endif %}>{{ b.closing_title }}</h2>
      <p data-reveal style="--i:1"><span id="closingHours">{% if b.today_hours %}今日 {{ b.today_hours }}{% endif %}</span></p>
      <div class="reach" data-reveal style="--i:2">
        {% if b.phone_href %}<a class="big" href="{{ b.phone_href }}">{{ b.phone }}</a>{% endif %}
        <div class="cta">
          {% if b.line_url %}<a class="btn btn-line" href="{{ b.line_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-chat"/></svg>LINE 聯絡</a>{% else %}<a class="btn btn-ghost" href="{{ b.maps_url }}" target="_blank" rel="noopener"><svg class="ico"><use href="#i-pin"/></svg>Google 導航</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <p>© {{ b.year }} <span class="nb">{{ b.name_zh }}</span>{% if b.name_zh != b.name %} <span class="nb">{{ b.name[(b.name_zh | length):] | trim }}</span>{% endif %}<i class="sep"></i>{{ b.city }}{{ b.district }}</p>
    <div class="links">
      {% if b.facebook_url %}<a href="{{ b.facebook_url }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
      {% if b.instagram_url %}<a href="{{ b.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
      {% if b.line_url %}<a href="{{ b.line_url }}" target="_blank" rel="noopener">LINE</a>{% endif %}
      <a href="{{ b.maps_url }}" target="_blank" rel="noopener">Google 地圖</a>
    </div>
    {% if b.credit %}<small>網站製作 <a href="{{ b.credit_url }}">{{ b.credit }}</a></small>{% endif %}
  </div>
</footer>

{% if b.phone_href or b.line_url %}<nav class="fab" aria-label="快速聯絡">{% if b.phone_href %}<a href="{{ b.phone_href }}" aria-label="打電話"><svg class="ico"><use href="#i-phone"/></svg></a>{% endif %}{% if b.line_url %}<a href="{{ b.line_url }}" target="_blank" rel="noopener" aria-label="LINE 聯絡"><svg class="ico"><use href="#i-chat"/></svg></a>{% endif %}<a href="{{ b.maps_url }}" target="_blank" rel="noopener" aria-label="導航到店"><svg class="ico"><use href="#i-pin"/></svg></a></nav>{% endif %}

{% if demo %}
<aside class="demo-bar" id="demoBar" aria-label="製作者提示">
  <span><strong><span class="nb">{{ b.name_zh }}</span>{% if b.name_zh != b.name %} <span class="nb">{{ b.name[(b.name_zh | length):] | trim }}</span>{% endif %}</strong> 老闆您好，這是<span class="long"> <span class="nb">{{ b.sitecraft_name }}</span></span>預先為您製作的網站草稿<span class="long">。</span><span class="short">，</span><strong class="nb">NT${{ b.price_twd }}</strong> 即可正式上線{% if not b.has_photos %}<span class="long">、換上您的照片</span>{% endif %}。</span>
  <span class="mt">網站草稿・<strong>NT${{ b.price_twd }}</strong> 正式上線</span>
  {% if b.sitecraft_contact_href %}<a href="{{ b.sitecraft_contact_href }}">聯絡我們</a>{% endif %}
