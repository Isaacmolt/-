  }else{d.querySelectorAll('[data-reveal]').forEach(function(el){el.classList.add('in')})}
  /* gallery strip */
  var strip=d.getElementById('strip'),tiles=strip?[].slice.call(strip.children):[],barEl=d.getElementById('stripBar');
