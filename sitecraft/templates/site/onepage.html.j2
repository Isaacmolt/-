<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ b.name }}｜{{ b.category }}｜{{ b.city }}{{ b.district }}</title>
<meta name="description" content="{{ b.name }}（{{ b.city }}{{ b.district }}{{ b.category }}）：{{ b.tagline }}。營業時間、地址地圖、電話與 LINE 聯絡方式一頁看完。">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ b.name }}｜{{ b.category }}">
<meta property="og:description" content="{{ b.tagline }}｜{{ b.address }}">
<meta property="og:url" content="{{ b.url }}">
<meta property="og:locale" content="zh_TW">
<link rel="canonical" href="{{ b.url }}">
<link rel="icon" href="data:image/svg+xml,{{ b.favicon_svg }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
<script type="application/ld+json">{{ b.jsonld | tojson }}</script>
<style>
:root{
  --p:{{ t.p }};--pd:{{ t.pd }};--a:{{ t.a }};--bg:{{ t.bg }};--sf:{{ t.sf }};
  --tx:{{ t.tx }};--mu:{{ t.mu }};--line:{{ t.line }};--p-soft:{{ t.p_soft }};--a-soft:{{ t.a_soft }};
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font-family:"Noto Sans TC",system-ui,-apple-system,"PingFang TC","Microsoft JhengHei",sans-serif;color:var(--tx);background:var(--bg);line-height:1.75;-webkit-font-smoothing:antialiased;{% if demo %}padding-bottom:72px;{% endif %}}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
ul{list-style:none}
.wrap{width:min(1100px,100% - 40px);margin-inline:auto}
@media (max-width:600px){.wrap{width:min(1100px,100% - 32px)}}

/* ---------- nav ---------- */
.nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.brand{font-weight:900;font-size:1.15rem;display:flex;align-items:center;gap:10px;white-space:nowrap}
.brand .mark{width:34px;height:34px;border-radius:10px;background:var(--p);color:#fff;display:grid;place-items:center;font-size:1rem}
.nav ul{display:flex;gap:28px;font-weight:500}
.nav ul a:hover{color:var(--p)}
.nav .call{background:var(--p);color:#fff;padding:9px 18px;border-radius:999px;font-weight:700;font-size:.95rem;white-space:nowrap}
.menu-btn{display:none;width:42px;height:42px;border:1px solid var(--line);border-radius:10px;background:transparent;cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:5px}
.menu-btn span{width:18px;height:2px;background:var(--tx);border-radius:2px}
@media (max-width:820px){
  .nav ul{display:none}
  .nav ul.open{display:flex;position:absolute;top:64px;left:0;right:0;flex-direction:column;background:var(--bg);padding:20px 24px;border-bottom:1px solid var(--line);gap:18px}
  .nav .call{display:none}
  .menu-btn{display:flex}
}

/* ---------- hero ---------- */
.hero{position:relative;background:linear-gradient(135deg,var(--p) 0%,var(--pd) 100%);color:#fff;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;opacity:.14;background-image:radial-gradient(rgba(255,255,255,.9) 1px,transparent 1px);background-size:22px 22px}
.hero::after{content:"{{ t.icon }}";position:absolute;right:-20px;bottom:-60px;font-size:22rem;opacity:.08;line-height:1;pointer-events:none}
.hero .wrap{position:relative;display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center;padding:84px 0 96px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.32);padding:6px 14px;border-radius:999px;font-size:.85rem;font-weight:600;letter-spacing:.06em}
h1{font-size:clamp(2.4rem,5.2vw,4rem);font-weight:900;line-height:1.15;margin:22px 0 14px;letter-spacing:.01em;text-wrap:balance}
.tagline{font-size:clamp(1.1rem,2vw,1.4rem);opacity:.94;font-weight:500;max-width:34ch;text-wrap:balance}
.rating{display:inline-flex;align-items:center;gap:10px;margin-top:22px;background:#fff;color:var(--tx);padding:8px 14px;border-radius:12px;font-weight:700;box-shadow:0 10px 30px rgba(0,0,0,.18)}
.rating .stars{color:#f5b301;letter-spacing:1px}
.rating small{font-weight:500;color:var(--mu)}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:14px 22px;border-radius:14px;font-weight:700;transition:transform .15s,box-shadow .15s,background .15s}
.btn:hover{transform:translateY(-2px)}
.btn-white{background:#fff;color:var(--pd);box-shadow:0 10px 24px rgba(0,0,0,.18)}
.btn-ghost{border:2px solid rgba(255,255,255,.7);color:#fff}
.btn-ghost:hover{background:rgba(255,255,255,.12)}
.btn-line{background:#06C755;color:#fff}
.card{background:#fff;color:var(--tx);border-radius:24px;padding:26px 28px;box-shadow:0 30px 60px rgba(0,0,0,.22)}
.card h3{font-size:.8rem;color:var(--mu);font-weight:700;letter-spacing:.12em;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.badge{font-size:.75rem;padding:3px 10px;border-radius:999px;background:#e7f7ec;color:#157a3c;font-weight:700;letter-spacing:0}
.badge.closed{background:#fbe5e5;color:#a12525}
.card .row{display:flex;gap:14px;padding:14px 0;border-top:1px solid var(--line);align-items:flex-start}
.card .row:first-of-type{border-top:0}
.card .ico{width:40px;height:40px;border-radius:12px;background:var(--p-soft);display:grid;place-items:center;flex:none;font-size:1.1rem}
.card b{display:block;font-size:.78rem;color:var(--mu);font-weight:600;margin-bottom:1px}
.card .row a:hover{color:var(--p);text-decoration:underline}
@media (max-width:900px){.hero .wrap{grid-template-columns:1fr;padding:60px 0 68px}.hero::after{font-size:14rem;right:-30px;bottom:-40px}}

/* ---------- sections ---------- */
section{padding:88px 0}
@media (max-width:700px){section{padding:64px 0}}
.sec-head{max-width:640px;margin-bottom:44px}
.kicker{color:var(--p);font-weight:800;letter-spacing:.14em;font-size:.82rem}
h2{font-size:clamp(1.75rem,3.2vw,2.4rem);font-weight:900;line-height:1.25;margin:8px 0 12px;text-wrap:balance}
.lead{color:var(--mu);font-size:1.05rem}

/* about */
.about .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
.about p{margin-bottom:16px;font-size:1.05rem}
.highlights{display:grid;gap:14px}
.highlights li{display:flex;gap:14px;align-items:center;background:var(--sf);border:1px solid var(--line);padding:16px 18px;border-radius:16px;font-weight:600}
.highlights .n{width:36px;height:36px;border-radius:10px;background:var(--p);color:#fff;display:grid;place-items:center;font-weight:900;flex:none}
@media (max-width:820px){.about .wrap{grid-template-columns:1fr;gap:32px}}

/* services */
.services{background:var(--sf)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}
.svc{background:var(--bg);border:1px solid var(--line);border-radius:20px;padding:28px 24px;transition:transform .2s,box-shadow .2s}
.svc:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,0,0,.08)}
.svc .ico{font-size:1.7rem;width:56px;height:56px;border-radius:16px;background:var(--p-soft);display:grid;place-items:center;margin-bottom:18px}
.svc h3{font-size:1.15rem;margin-bottom:6px}
.svc p{color:var(--mu);font-size:.97rem}

/* gallery */
.gallery .tiles{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:230px;gap:14px}
.tile{border-radius:18px;background:linear-gradient(135deg,var(--p-soft),var(--a-soft));display:grid;place-items:center;font-size:3.2rem;position:relative;overflow:hidden;border:1px solid var(--line)}
.tile:nth-child(3n+2){background:linear-gradient(160deg,var(--a-soft),var(--p-soft))}
.tile img{width:100%;height:100%;object-fit:cover}
.tile span{position:absolute;bottom:10px;left:12px;font-size:.72rem;color:var(--mu);background:rgba(255,255,255,.88);padding:3px 9px;border-radius:999px;font-weight:600}
@media (max-width:700px){.gallery .tiles{grid-template-columns:repeat(2,1fr);grid-auto-rows:160px;gap:10px}}

/* info */
.info{background:var(--sf)}
.info .cols{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.hours{background:var(--bg);border:1px solid var(--line);border-radius:20px;overflow:hidden}
.hours li{display:flex;justify-content:space-between;gap:12px;padding:13px 20px;border-top:1px solid var(--line);font-size:.98rem}
.hours li:first-child{border-top:0}
.hours li.today{background:var(--p-soft);font-weight:800}
.hours li.today span:first-child::after{content:"今天";font-size:.7rem;margin-left:8px;background:var(--p);color:#fff;padding:2px 7px;border-radius:999px;vertical-align:middle;font-weight:700}
.hours .closed{color:#a12525}
.map{border-radius:20px;overflow:hidden;border:1px solid var(--line);min-height:380px;background:var(--bg)}
.map iframe{width:100%;height:100%;min-height:380px;border:0;display:block}
.addr{display:flex;flex-direction:column;gap:10px;margin-top:18px}
.addr a{display:inline-flex;align-items:center;gap:10px;font-weight:600}
.addr a:hover{color:var(--p)}
.addr .ico{width:34px;height:34px;border-radius:10px;background:var(--p-soft);display:grid;place-items:center;flex:none}
@media (max-width:820px){.info .cols{grid-template-columns:1fr;gap:28px}}

/* footer */
footer{background:var(--tx);color:#fff;padding:56px 0 32px}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:28px;align-items:flex-end}
footer .fname{font-size:1.4rem;font-weight:900;margin-bottom:8px}
footer p{opacity:.72;font-size:.95rem}
footer .social{display:flex;gap:10px;margin-top:14px}
footer .social a{padding:8px 14px;border:1px solid rgba(255,255,255,.25);border-radius:999px;font-size:.85rem;font-weight:600}
footer .social a:hover{background:rgba(255,255,255,.1)}
footer small{display:block;opacity:.5;margin-top:6px;font-size:.8rem}
footer small a{text-decoration:underline}

/* mobile call button */
.fab{position:fixed;right:16px;bottom:{% if demo %}88px{% else %}16px{% endif %};z-index:40;width:56px;height:56px;border-radius:50%;background:var(--p);color:#fff;display:none;place-items:center;font-size:1.4rem;box-shadow:0 12px 30px rgba(0,0,0,.28)}
@media (max-width:820px){.fab{display:grid}}

{% if demo %}
/* demo bar */
.demo-bar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:#111827;color:#fff;font-size:.9rem;padding:12px 48px 12px 16px;display:flex;gap:6px 14px;align-items:center;justify-content:center;flex-wrap:wrap;text-align:center;box-shadow:0 -10px 30px rgba(0,0,0,.2)}
.demo-bar strong{color:#fde047}
.demo-bar a{color:#fff;background:var(--p);padding:6px 14px;border-radius:999px;font-weight:700;white-space:nowrap}
.demo-bar button{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:transparent;border:0;color:#fff;font-size:1.3rem;cursor:pointer;opacity:.7;padding:6px}
@media (max-width:600px){.demo-bar{font-size:.82rem;padding:10px 40px 10px 12px;gap:4px 10px}.demo-bar .long{display:none}}
{% endif %}
/* reveal */
[data-reveal]{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
[data-reveal].in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){[data-reveal]{opacity:1;transform:none;transition:none}}
</style>
</head>
<body>

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top"><span class="mark">{{ t.icon }}</span>{{ b.name }}</a>
    <ul id="menu">
      <li><a href="#about">關於我們</a></li>
      <li><a href="#services">服務項目</a></li>
      <li><a href="#gallery">環境照片</a></li>
      <li><a href="#info">營業資訊</a></li>
    </ul>
    {% if b.phone_href %}<a class="call" href="{{ b.phone_href }}">📞 {{ b.phone }}</a>{% endif %}
    <button class="menu-btn" id="menuBtn" aria-label="選單" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</header>

<section class="hero" id="top">
  <div class="wrap">
    <div>
      <span class="eyebrow">{{ t.icon }} {{ b.category }}・{{ b.city }}{{ b.district }}</span>
      <h1>{{ b.name }}</h1>
      <p class="tagline">{{ b.tagline }}</p>
      {% if b.rating %}
      <a class="rating" href="{{ b.maps_url }}" target="_blank" rel="noopener">
        <span class="stars">{{ b.stars }}</span>{{ b.rating }}<small>・Google {{ b.review_count }} 則評論</small>
      </a>
      {% endif %}
      <div class="cta">
        {% if b.phone_href %}<a class="btn btn-white" href="{{ b.phone_href }}">📞 撥打電話</a>{% endif %}
        {% if b.line_url %}<a class="btn btn-line" href="{{ b.line_url }}" target="_blank" rel="noopener">💬 LINE 聯絡</a>{% endif %}
        <a class="btn btn-ghost" href="{{ b.maps_url }}" target="_blank" rel="noopener">📍 Google 導航</a>
      </div>
    </div>
    <aside class="card">
      <h3>店家資訊 <span class="badge" id="openBadge" hidden></span></h3>
      {% if b.today_hours %}
      <div class="row"><div class="ico">🕒</div><div><b>今日營業時間</b><span id="todayHours">{{ b.today_hours }}</span></div></div>
      {% endif %}
      <div class="row"><div class="ico">📍</div><div><b>地址</b><a href="{{ b.maps_url }}" target="_blank" rel="noopener">{{ b.address }}</a></div></div>
      {% if b.phone %}<div class="row"><div class="ico">📞</div><div><b>電話</b><a href="{{ b.phone_href }}">{{ b.phone }}</a></div></div>{% endif %}
      {% if b.line_url %}<div class="row"><div class="ico">💬</div><div><b>LINE</b><a href="{{ b.line_url }}" target="_blank" rel="noopener">加入好友、直接詢問</a></div></div>{% endif %}
    </aside>
  </div>
</section>

<section class="about" id="about">
  <div class="wrap">
    <div data-reveal>
      <div class="sec-head" style="margin-bottom:24px">
        <div class="kicker">ABOUT</div>
        <h2>關於 {{ b.name }}</h2>
      </div>
      {% for para in b.about_paragraphs %}<p>{{ para }}</p>{% endfor %}
    </div>
    <ul class="highlights" data-reveal>
      {% for h in b.highlights %}<li><span class="n">{{ loop.index }}</span>{{ h }}</li>{% endfor %}
    </ul>
  </div>
</section>

<section class="services" id="services">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <div class="kicker">SERVICES</div>
      <h2>服務項目</h2>
      <p class="lead">有其他需求也歡迎直接詢問，我們會盡力協助。</p>
    </div>
    <div class="grid">
      {% for s in b.services %}
      <article class="svc" data-reveal>
        <div class="ico">{{ s.icon }}</div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.desc }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="gallery" id="gallery">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <div class="kicker">GALLERY</div>
      <h2>環境與作品</h2>
      {% if demo %}<p class="lead">正式版會換上您的實拍照片，這裡先用示意圖代替。</p>{% endif %}
    </div>
    <div class="tiles" data-reveal>
      {% for g in b.gallery_items %}
      <div class="tile">{% if g.img %}<img src="{{ g.img }}" alt="{{ b.name }} 照片 {{ loop.index }}" loading="lazy">{% else %}{{ g.icon }}{% if demo %}<span>示意圖</span>{% endif %}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="info" id="info">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <div class="kicker">INFO</div>
      <h2>營業資訊與位置</h2>
    </div>
    <div class="cols">
      <div data-reveal>
        {% if b.weekday_hours %}
        <ul class="hours" id="hours">
          {% for h in b.weekday_hours %}
          <li data-day="{{ h.day }}"><span>{{ h.label }}</span><span class="{% if h.closed %}closed{% endif %}">{{ h.text }}</span></li>
          {% endfor %}
        </ul>
        {% else %}
        <ul class="hours"><li><span>營業時間</span><span>請來電詢問</span></li></ul>
        {% endif %}
        <div class="addr">
          <a href="{{ b.maps_url }}" target="_blank" rel="noopener"><span class="ico">📍</span>{{ b.address }}</a>
          {% if b.phone %}<a href="{{ b.phone_href }}"><span class="ico">📞</span>{{ b.phone }}</a>{% endif %}
          {% if b.line_url %}<a href="{{ b.line_url }}" target="_blank" rel="noopener"><span class="ico">💬</span>LINE 聯絡我們</a>{% endif %}
        </div>
      </div>
      <div class="map" data-reveal>
        <iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{{ b.name }} 地圖" src="{{ b.embed_url }}"></iframe>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div>
      <div class="fname">{{ t.icon }} {{ b.name }}</div>
      <p>{{ b.address }}{% if b.phone %}　{{ b.phone }}{% endif %}</p>
      {% if b.facebook_url or b.instagram_url or b.line_url %}
      <div class="social">
        {% if b.facebook_url %}<a href="{{ b.facebook_url }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
        {% if b.instagram_url %}<a href="{{ b.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
        {% if b.line_url %}<a href="{{ b.line_url }}" target="_blank" rel="noopener">LINE</a>{% endif %}
      </div>
      {% endif %}
    </div>
    <div>
      <p>© {{ b.year }} {{ b.name }}</p>
      {% if b.credit %}<small>網站製作：<a href="{{ b.credit_url }}">{{ b.credit }}</a></small>{% endif %}
    </div>
  </div>
</footer>

{% if b.phone_href %}<a class="fab" href="{{ b.phone_href }}" aria-label="撥打電話">📞</a>{% endif %}

{% if demo %}
<div class="demo-bar" id="demoBar">
  <span>👋 <strong>{{ b.name }}</strong> 老闆您好，這是 {{ b.sitecraft_name }} 預先為您製作的網站草稿。</span>
  <span><span class="long">喜歡的話 </span><strong>NT${{ b.price_twd }}</strong> 即可正式上線<span class="long">、換上您的照片</span>。</span>
  {% if b.sitecraft_contact_href %}<a href="{{ b.sitecraft_contact_href }}">聯絡我們</a>{% endif %}
  <button aria-label="關閉" onclick="document.getElementById('demoBar').remove();document.body.style.paddingBottom='0'">×</button>
</div>
{% endif %}

<script>
(function(){
  var btn=document.getElementById('menuBtn'),menu=document.getElementById('menu');
  if(btn){btn.addEventListener('click',function(){var o=menu.classList.toggle('open');btn.setAttribute('aria-expanded',o)});
    menu.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){menu.classList.remove('open')})})}
  var day=new Date().getDay();
  var li=document.querySelector('#hours li[data-day="'+day+'"]');
  if(li){li.classList.add('today');var th=document.getElementById('todayHours');if(th){th.textContent=li.children[1].textContent}}
  var periods={{ b.periods | tojson }};
  if(periods&&periods.length){
    var n=new Date(),mins=n.getHours()*60+n.getMinutes(),open=false;
    periods.forEach(function(p){if(!p.open||!p.close)return;
      var od=p.open.day,cd=p.close.day,om=p.open.hour*60+(p.open.minute||0),cm=p.close.hour*60+(p.close.minute||0);
      if(od===day&&cd===day&&mins>=om&&mins<cm)open=true;
      if(od===day&&cd!==day&&mins>=om)open=true;
      if(cd===day&&od!==day&&mins<cm)open=true;});
    var bd=document.getElementById('openBadge');if(bd){bd.hidden=false;bd.textContent=open?'營業中':'休息中';if(!open)bd.classList.add('closed')}
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
    document.querySelectorAll('[data-reveal]').forEach(function(el){io.observe(el)});
  }else{document.querySelectorAll('[data-reveal]').forEach(function(el){el.classList.add('in')})}
})();
</script>
</body>
</html>
